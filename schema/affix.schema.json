{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:move-idle:schema:affix:v1",
  "title": "词缀（stat 或 legendary）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind"],
  "properties": {
    "id": { "$ref": "urn:move-idle:schema:common:v1#/$defs/id" },
    "name": {
      "$ref": "urn:move-idle:schema:common:v1#/$defs/name",
      "description": "stat 词缀：前缀/后缀用词（如「锋利」「之焰」）；legendary 词缀：完整传奇名。"
    },
    "flavor": { "$ref": "urn:move-idle:schema:common:v1#/$defs/flavor" },
    "kind": { "enum": ["stat", "legendary"] },
    "position": {
      "enum": ["prefix", "suffix", "any"],
      "description": "命名生成用：前缀词、后缀词或任意。"
    },
    "mods": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:move-idle:schema:common:v1#/$defs/tiered_stat_mod" },
      "description": "kind=stat 时必填：档位化属性修改。"
    },
    "legendary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects"],
      "properties": {
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:move-idle:schema:common:v1#/$defs/effect_primitive" }
        },
        "power_rating": {
          "type": "number",
          "minimum": 0,
          "description": "可选的强度自评分（供编辑器/人工平衡参考，引擎不消费）。"
        }
      },
      "description": "kind=legendary 时必填：效果原语组合。"
    },
    "custom": {
      "$ref": "urn:move-idle:schema:common:v1#/$defs/flavor",
      "description": "逃生舱：自由文本效果想法。导入器必须对其发出「引擎未验证」警告，绝不静默执行。"
    },
    "allowed_slots": {
      "type": "array",
      "items": { "enum": ["weapon", "armor", "trinket"] }
    },
    "allowed_categories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "stat" } } },
      "then": { "required": ["position", "mods"] }
    },
    {
      "if": { "properties": { "kind": { "const": "legendary" } } },
      "then": { "required": ["legendary"] }
    }
  ]
}
