#!/bin/sh
# 反模式 lint（pre-commit）：与 CI 同源，规则来源 docs/agents/godot-standards.md 机器执法节
# 与 docs/research/godot-4-5-to-4-7-changes.md。编译能过但语义已变的 4.5+ API 用法在此拦截。
# 新克隆装机：git config core.hooksPath .githooks
# 扫描范围为整个 game（文件少，全扫成本低于增量判定的复杂度）。

matches=$(grep -rniE '\.device[[:space:]]*[!=]=[[:space:]]*0\b|size_in_percent|width_in_percent|height_in_percent|get_as_text[[:space:]]*\([[:space:]]*[^)]|tap_back_pos|instance_set_interpolated|instance_reset_physics_interpolation|get_rpc_config|\.duplicate[[:space:]]*\([[:space:]]*true[[:space:]]*\)' game --include='*.gd')

if [ -n "$matches" ]; then
  echo "$matches"
  echo ""
  echo "pre-commit 拦截：命中 4.5+ 已改名/已移除/语义变更 API 反模式。"
  echo "对照 docs/agents/godot-standards.md 硬规则修复后重试；若为 lint 模式误报，先修订本钩子与 CI 中的模式再提交。"
  exit 1
fi

# 文档互引完整性（与 .github/workflows/docs.yml 同源，勿分叉）。
# 悬空指针是文档重排 / 回滚后最易腐、肉眼最难发现的一类问题（审计 F2）。
# 用 source 而非 sh 调用：钩子本身由 sh 执行，source 不依赖 PATH 里有没有 sh，
# 且脚本缺失时是硬失败而不是静默跳过（静默跳过 = 假绿）。
. "$(git rev-parse --show-toplevel)/tools/check-doc-links.sh"

# 内容库校验（#26）：schema + 引用完整性 + id 规则的唯一真相（tools/validator/README.md）。
# 每次提交全库跑（成本 <1s）；依赖未装 / node 过旧 = 硬失败而非静默跳过（假绿防线）。
repo_root="$(git rev-parse --show-toplevel)"
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit 拦截：未找到 node（校验器需 Node.js >= 24，原生 TS 运行）。安装后重试提交。"
  exit 1
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)'; then
  echo "pre-commit 拦截：node 版本过低（$(node --version)），校验器需 Node.js >= 24。升级后重试提交。"
  exit 1
fi
if [ ! -d "$repo_root/tools/validator/node_modules" ]; then
  echo "pre-commit 拦截：tools/validator 依赖未安装。"
  echo "先执行：cd tools/validator && npm install ，再重试提交。"
  exit 1
fi
if ! node "$repo_root/tools/validator/src/cli.ts" --content "$repo_root/content" --schema "$repo_root/schema"; then
  echo "pre-commit 拦截：内容库校验未过（见上方 JSON 的 errors[]，按 file/field/reason 定位修复）。"
  exit 1
fi
